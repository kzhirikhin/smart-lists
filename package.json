{
  "name": "smart-lists",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:audit-privileges": "node scripts/audit-database-privileges.mjs",
    "db:prune-audit-events": "node scripts/prune-audit-events.mjs",
    "db:configure-operational-roles": "node scripts/configure-operational-roles.mjs",
    "db:configure-runtime-role": "node scripts/configure-runtime-role.mjs",
    "db:configure-tenant-enforcement": "node scripts/configure-tenant-enforcement.mjs",
    "migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security:static": "vitest run --config vitest.security.config.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:roles": "node scripts/run-database-role-integration.mjs",
    "test:integration:runtime": "node scripts/run-database-role-integration.mjs",
    "test:integration:db": "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "test:integration:db:down": "docker compose -f docker-compose.test.yml down",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:db": "docker compose -f docker-compose.test.yml --profile e2e up -d --wait postgres-e2e",
    "test:e2e:db:down": "docker compose -f docker-compose.test.yml --profile e2e down",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-presigned-post": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/oidc": "^3.8.5",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "dotenv": "^17.2.3",
    "framer-motion": "^13.1.1",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid@3": "3.3.18",
    "ajv@6": "6.14.0",
    "minimatch@3": "3.1.4",
    "minimatch@9": "9.0.7",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@5": "5.0.9",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.5",
    "mysql2@3": "3.24.2",
    "@babel/core": "^7.29.6"
  }
}
